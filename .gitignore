.DS_Store
**/.DS_Store

# Local/generated project spaces. Keep only the placeholder files below.
/inputs/*
!/inputs/.gitkeep
/outputs/*
!/outputs/.gitkeep
/tmp/*
!/tmp/.gitkeep

# Development-only history and tests are not part of the public Skill package.
/docs/
/tests/

# Build/cache/runtime noise.
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
node_modules/
dist/
build/
*.log
*.tmp
*.zip

# Local secrets and environment overrides.
.env
.env.*
!.env.example
