{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PPT Skill v3 Design Contract",
  "type": "object",
  "required": [
    "schema_version",
    "route_family",
    "communication_path",
    "source_policy",
    "audience_profile",
    "visual_system_intent",
    "layout_grammar",
    "stage2_cover_option_strategy",
    "stage2_qa_focus"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "education_context": {
      "type": "object",
      "properties": {
        "is_k12": {
          "type": "boolean"
        },
        "confidence": {
          "type": "string",
          "enum": [
            "explicit_user_request",
            "inferred_high",
            "inferred_medium",
            "unknown"
          ]
        },
        "school_stage": {
          "type": "string",
          "enum": [
            "primary",
            "junior_high",
            "senior_high",
            "unknown"
          ]
        },
        "grade": {
          "type": "string"
        },
        "subject": {
          "type": "string"
        },
        "subject_group": {
          "type": "string",
          "enum": [
            "language",
            "math",
            "foreign_language",
            "science",
            "humanities",
            "arts",
            "integrated",
            "unknown"
          ]
        },
        "textbook_version": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "lesson_title": {
          "type": "string"
        },
        "lesson_number": {
          "type": "string"
        },
        "class_type": {
          "type": "string"
        },
        "lesson_scope": {
          "type": "string",
          "enum": [
            "single_lesson",
            "unit_review",
            "thematic_project",
            "unknown"
          ]
        },
        "period_count": {
          "type": "integer",
          "minimum": 1
        },
        "minutes_per_period": {
          "type": "integer",
          "minimum": 1
        },
        "period_strategy": {
          "type": "string",
          "enum": [
            "explicit",
            "inferred_from_stage1",
            "inferred_from_textbook",
            "single_period_default",
            "needs_confirmation"
          ]
        },
        "curriculum_standard": {
          "type": "string"
        },
        "textbook_material_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "route_family": {
      "type": "string",
      "enum": [
        "teaching",
        "nursing_care",
        "academic_defense",
        "competition_pitch",
        "professional_report",
        "speech_launch",
        "source_redesign",
        "visual_remake"
      ]
    },
    "communication_path": {
      "type": "string",
      "enum": [
        "learning_path",
        "care_action_path",
        "argument_path",
        "pitch_thesis_path",
        "report_decision_path",
        "original_slide_upgrade_path"
      ]
    },
    "source_policy": {
      "type": "object",
      "required": [
        "mode",
        "content_mutation_level",
        "rules"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "new_deck",
            "source_rewrite",
            "visual_remake"
          ]
        },
        "primary_materials": {
          "type": "array"
        },
        "supporting_materials": {
          "type": "array"
        },
        "content_mutation_level": {
          "type": "string",
          "enum": [
            "preserve",
            "soft_polish",
            "restructure",
            "compress"
          ]
        },
        "conflict_resolution": {
          "type": "string"
        },
        "rules": {
          "type": "array"
        }
      },
      "additionalProperties": true
    },
    "audience_profile": {
      "type": "object",
      "required": [
        "primary_audience"
      ],
      "properties": {
        "primary_audience": {
          "type": "string"
        },
        "knowledge_level": {
          "type": "string"
        },
        "viewing_context": {
          "type": "string"
        },
        "attention_pattern": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "visual_system_intent": {
      "type": "object",
      "required": [
        "tone_keywords"
      ],
      "properties": {
        "tone_keywords": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "formality": {
          "type": "string"
        },
        "warmth": {
          "type": "string"
        },
        "visual_energy": {
          "type": "string"
        },
        "authority_level": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "color_contract": {
      "type": "object"
    },
    "typography_contract": {
      "type": "object"
    },
    "image_language": {
      "type": "object"
    },
    "layout_grammar": {
      "type": "object",
      "required": [
        "page_role_taxonomy"
      ],
      "properties": {
        "page_role_taxonomy": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "reading_path": {
          "type": "string"
        },
        "rhythm_policy": {
          "type": "string"
        },
        "layout_repetition_limit": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "stage2_cover_option_strategy": {
      "type": "object",
      "required": [
        "option_briefs"
      ],
      "properties": {
        "option_dimensions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "option_briefs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "option_id"
            ],
            "properties": {
              "option_id": {
                "type": "string",
                "enum": [
                  "A",
                  "B",
                  "C",
                  "D"
                ]
              },
              "style_positioning": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "stage2_qa_focus": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "image_style_references": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "material_id",
          "interpretation",
          "use"
        ],
        "properties": {
          "material_id": {
            "type": "string",
            "minLength": 1
          },
          "interpretation": {
            "type": "string",
            "minLength": 1
          },
          "use": {
            "type": "string",
            "minLength": 1
          },
          "mode": {
            "enum": [
              "text_analysis"
            ]
          },
          "slide_indices": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
