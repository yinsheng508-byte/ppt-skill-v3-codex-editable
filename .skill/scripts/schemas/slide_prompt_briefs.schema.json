{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PPT Skill v3 Slide Prompt Briefs",
  "type": "object",
  "required": [
    "schema_version",
    "slides"
  ],
  "properties": {
    "schema_version": {
      "const": "2.3"
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "slide_index",
          "page_role",
          "message_goal",
          "final_visible_text",
          "visual_composition",
          "negative_constraints",
          "acceptance_criteria"
        ],
        "properties": {
          "slide_index": {
            "type": "integer"
          },
          "page_role": {
            "type": "string"
          },
          "message_goal": {
            "type": "string"
          },
          "final_visible_text": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "visual_composition": {
            "type": "string"
          },
          "layout_family": {
            "type": "string"
          },
          "density_budget": {
            "type": "string"
          },
          "visual_anchor": {
            "type": "string"
          },
          "content_fidelity_policy": {
            "type": "string"
          },
          "main_visual_elements": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "style_constraints": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "negative_constraints": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "acceptance_criteria": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "image_prompt_plan": {
            "type": "object",
            "required": [
              "version",
              "basis_hash",
              "visual",
              "style",
              "layout",
              "constraints",
              "text_roles"
            ],
            "properties": {
              "version": {
                "const": "1"
              },
              "basis_hash": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "visual": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "style": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "layout": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "constraints": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "text_roles": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "subtitle": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "module_index": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "module_title": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "module_subtitle": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "page_number": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        }
      }
    }
  },
  "additionalProperties": true
}
