{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ppt-skill-v2.local/schemas/officecli_manifest.schema.json",
  "title": "PPT Skill Stage3 OfficeCLI Builder Manifest",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "provider",
    "officecli_version",
    "mode",
    "pptx_source",
    "slides_count",
    "commands",
    "command_results",
    "readback",
    "background_placements",
    "text_shapes",
    "warnings",
    "errors"
  ],
  "properties": {
    "schema_version": { "type": "string", "minLength": 1 },
    "provider": { "const": "officecli" },
    "officecli_version": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["full_deck", "native_style_probe"] },
    "coordinate_plan": { "type": ["string", "object"] },
    "pptx_source": { "type": "string", "minLength": 1 },
    "pptx_sha256": { "type": "string", "pattern": "^sha256:" },
    "slides_count": { "type": "integer", "minimum": 1 },
    "commands": { "type": "string", "minLength": 1 },
    "command_results": { "type": "string", "minLength": 1 },
    "background_placements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["slide_index", "name", "x", "y", "width", "height", "placement_mode"],
        "properties": {
          "slide_index": { "type": "integer", "minimum": 1 },
          "name": { "type": "string", "minLength": 1 },
          "x": { "type": "number" },
          "y": { "type": "number" },
          "width": { "type": "number", "exclusiveMinimum": 0 },
          "height": { "type": "number", "exclusiveMinimum": 0 },
          "placement_mode": { "const": "exact_full_slide" },
          "crop": { "type": "boolean" }
        },
        "additionalProperties": true
      }
    },
    "text_shapes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["slide_index", "text_unit_id", "shape_path", "shape_id", "shape_name", "relative_box", "readback_relative_box"],
        "properties": {
          "slide_index": { "type": "integer", "minimum": 1 },
          "text_unit_id": { "type": "string", "minLength": 1 },
          "shape_path": { "type": "string", "minLength": 1 },
          "shape_id": {
            "oneOf": [
              { "type": "integer" },
              { "type": "string", "minLength": 1 }
            ]
          },
          "shape_name": { "type": "string", "minLength": 1 },
          "ownership_id": { "type": ["string", "null"] },
          "split_unit_id": { "type": ["string", "null"] },
          "style_profile_id": { "type": ["string", "null"] },
          "relative_box": { "$ref": "#/$defs/relative_box" },
          "font_family": { "type": ["string", "null"] },
          "font_ea": { "type": ["string", "null"] },
          "font_latin": { "type": ["string", "null"] },
          "font_cs": { "type": ["string", "null"] },
          "font_size_pt": { "type": ["number", "null"] },
          "bold": { "type": ["boolean", "null"] },
          "line_spacing": { "type": ["number", "string", "null"] },
          "margin": { "type": ["array", "string", "null"] },
          "valign": { "type": ["string", "null"] },
          "readback_relative_box": { "$ref": "#/$defs/relative_box" }
        },
        "additionalProperties": true
      }
    },
    "native_shapes": { "type": "array", "items": { "type": "object" } },
    "readback": {
      "type": "object",
      "required": ["path", "slides_count", "source"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "slides_count": { "type": "integer", "minimum": 1 },
        "source": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "warnings": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "errors": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
  },
  "$defs": {
    "relative_box": {
      "type": "object",
      "required": ["x", "y", "w", "h"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "w": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "h": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      },
      "additionalProperties": true
    }
  }
}
