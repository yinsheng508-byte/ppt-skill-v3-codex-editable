{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PPT Skill v2 Style Template Registry",
  "type": "object",
  "required": ["schema_version", "templates"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "purpose": { "type": "string" },
    "templates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "status",
          "template_path",
          "triggers",
          "description",
          "usage_policy"
        ],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "display_name": { "type": "string" },
          "status": { "enum": ["active", "draft", "deprecated"] },
          "template_path": { "type": "string" },
          "triggers": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "description": { "type": "string" },
          "route_hints": {
            "type": "array",
            "items": { "type": "string" }
          },
          "style_tags": {
            "type": "array",
            "items": { "type": "string" }
          },
          "default_font_family": { "type": "string" },
          "palette_hint": { "type": "object" },
          "usage_policy": {
            "type": "object",
            "required": [
              "requires_stage_flow",
              "skip_user_confirmations",
              "page_number_default"
            ],
            "properties": {
              "requires_stage_flow": { "type": "boolean" },
              "skip_user_confirmations": { "type": "boolean" },
              "page_number_default": { "type": "boolean" }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
