{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PPT Skill v2 Project State",
  "type": "object",
  "required": [
    "schema_version",
    "project_name",
    "run_dir",
    "current_stage",
    "status",
    "required_actor",
    "confirmed",
    "user_artifacts",
    "runtime_artifacts",
    "updated_at"
  ],
  "properties": {
    "schema_version": { "const": "2.0" },
    "project_name": { "type": "string" },
    "run_dir": { "type": "string" },
    "current_stage": {
      "enum": ["stage0", "stage1", "stage2", "stage3", "stage4"]
    },
    "status": { "type": "string" },
    "required_actor": {
      "enum": ["main_controller", "user", "runtime", "image_provider", "editable_ppt_provider", "none"]
    },
    "last_decision_id": { "type": ["string", "null"] },
    "stage4_outputs": {
      "type": "object",
      "properties": {
        "speaker_script": {
          "type": "object",
          "properties": {
            "required": { "type": "boolean" },
            "status": { "type": "string" }
          },
          "additionalProperties": true
        },
        "lesson_plan": {
          "type": "object",
          "properties": {
            "required": { "type": "boolean" },
            "required_reason": { "type": ["string", "null"] },
            "status": { "type": "string" },
            "skip_reason": { "type": ["string", "null"] }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "confirmed": { "type": "object" },
    "user_artifacts": { "type": "object" },
    "expected_user_paths": { "type": "object" },
    "runtime_artifacts": { "type": "object" },
    "quality": { "type": "object" },
    "next_required_action": { "type": "string" },
    "updated_at": { "type": "string" }
  },
  "additionalProperties": true
}
