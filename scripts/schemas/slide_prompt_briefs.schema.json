{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PPT Skill v2.3 Slide Prompt Briefs",
  "type": "object",
  "required": ["schema_version", "slides"],
  "properties": {
    "schema_version": { "const": "2.3" },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "slide_index",
          "page_role",
          "message_goal",
          "final_visible_text",
          "visual_composition",
          "negative_constraints",
          "acceptance_criteria"
        ],
        "properties": {
          "slide_index": { "type": "integer" },
          "page_role": { "type": "string" },
          "message_goal": { "type": "string" },
          "final_visible_text": { "type": "array", "items": { "type": "string" } },
          "visual_composition": { "type": "string" },
          "layout_family": { "type": "string" },
          "density_budget": { "type": "string" },
          "visual_anchor": { "type": "string" },
          "content_fidelity_policy": { "type": "string" },
          "main_visual_elements": { "type": "array", "items": { "type": "string" } },
          "style_constraints": { "type": "array", "items": { "type": "string" } },
          "negative_constraints": { "type": "array", "items": { "type": "string" } },
          "acceptance_criteria": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  },
  "additionalProperties": true
}
