{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PPT Skill Stage3 Coordinate QA Review",
  "type": "object",
  "required": ["schema_version", "overall_status", "contact_sheet", "checks", "slides"],
  "properties": {
    "schema_version": { "const": "2.0" },
    "overall_status": { "enum": ["passed", "needs_rework"] },
    "contact_sheet": { "type": "string", "minLength": 1 },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coordinate_text_units_covered",
        "content_text_accuracy",
        "native_render_alignment",
        "no_obvious_overlap_or_overflow",
        "background_fidelity",
        "high_risk_pages_reviewed"
      ],
      "properties": {
        "coordinate_text_units_covered": { "$ref": "#/$defs/check_status" },
        "content_text_accuracy": { "$ref": "#/$defs/check_status" },
        "native_render_alignment": { "$ref": "#/$defs/check_status" },
        "no_obvious_overlap_or_overflow": { "$ref": "#/$defs/check_status" },
        "background_fidelity": { "$ref": "#/$defs/check_status" },
        "high_risk_pages_reviewed": { "$ref": "#/$defs/check_status" }
      }
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["slide_index", "status", "review_assets", "checked_text_unit_ids"],
        "properties": {
          "slide_index": { "type": "integer" },
          "status": { "enum": ["passed", "needs_rework"] },
          "review_assets": {
            "type": "object",
            "required": ["stage2_image", "stage3_background", "editable_render"],
            "properties": {
              "stage2_image": { "type": "string", "minLength": 1 },
              "stage3_background": { "type": "string", "minLength": 1 },
              "editable_render": { "type": "string", "minLength": 1 }
            }
          },
          "checked_text_unit_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "notes": { "type": "string" }
        }
      }
    },
    "native_style_probe": {
      "type": "object",
      "required": ["profile", "probe_compare", "review_status"],
      "properties": {
        "profile": { "type": "string", "minLength": 1 },
        "probe_compare": { "type": "string", "minLength": 1 },
        "probe_manifest": { "type": "string", "minLength": 1 },
        "probe_pptx": { "type": "string", "minLength": 1 },
        "review_status": { "enum": ["passed", "needs_rework", "not_applicable"] },
        "notes": { "type": "string" }
      },
      "additionalProperties": true
    },
    "font_probe": {
      "type": "object",
      "deprecated": true,
      "required": ["profile", "probe_compare", "review_status"],
      "properties": {
        "profile": { "type": "string", "minLength": 1 },
        "probe_compare": { "type": "string", "minLength": 1 },
        "review_status": { "enum": ["passed", "needs_rework", "not_applicable"] },
        "notes": { "type": "string" }
      },
      "additionalProperties": true
    },
    "split_granularity_review": {
      "type": "object",
      "required": ["reviewed", "high_risk_slides"],
      "properties": {
        "reviewed": { "type": "boolean" },
        "high_risk_slides": { "type": "array", "items": { "type": "integer" } },
        "notes": { "type": "string" }
      },
      "additionalProperties": true
    },
    "ai_quality_profile": { "type": "string", "minLength": 1 },
    "controller_review_plan": { "type": "string", "minLength": 1 },
    "accepted_quality_tradeoffs": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string", "minLength": 1 },
          { "type": "object", "additionalProperties": true }
        ]
      }
    },
    "recommended_high_risk_coverage": {
      "type": "object",
      "required": ["recommended_slides", "reviewed_slides", "not_reviewed_with_reason"],
      "properties": {
        "recommended_slides": { "type": "array", "items": { "type": "integer" } },
        "reviewed_slides": { "type": "array", "items": { "type": "integer" } },
        "not_reviewed_with_reason": {
          "type": "array",
          "items": {
            "oneOf": [
              { "type": "string", "minLength": 1 },
              {
                "type": "object",
                "properties": {
                  "slide_index": { "type": "integer" },
                  "reason": { "type": "string", "minLength": 1 }
                },
                "additionalProperties": true
              }
            ]
          }
        },
        "notes": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "check_status": { "enum": ["passed", "failed", "needs_rework", "not_applicable"] }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "overall_status": { "const": "passed" }
        },
        "required": ["overall_status"]
      },
      "then": {
        "properties": {
          "checks": {
            "properties": {
              "coordinate_text_units_covered": { "const": "passed" },
              "content_text_accuracy": { "const": "passed" },
              "native_render_alignment": { "enum": ["passed", "not_applicable"] },
              "no_obvious_overlap_or_overflow": { "const": "passed" },
              "background_fidelity": { "const": "passed" },
              "high_risk_pages_reviewed": { "enum": ["passed", "not_applicable"] }
            }
          },
          "slides": {
            "items": {
              "properties": {
                "status": { "const": "passed" }
              }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": true
}
