{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PPT Skill Layout Safety Contract",
  "type": "object",
  "required": ["schema_version", "basis", "slides"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "basis": { "type": "object" },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["slide_index", "page_role", "density_decision", "editable_text_regions", "text_ownership_policy"],
        "properties": {
          "slide_index": { "type": "integer" },
          "page_role": { "type": "string", "minLength": 1 },
          "density_decision": { "enum": ["fits", "tight_but_acceptable", "too_dense_split_required"] },
          "editable_text_regions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/region" } },
          "visual_regions": { "type": "array", "items": { "$ref": "#/$defs/region" } },
          "exclusion_zones": { "type": "array", "items": { "$ref": "#/$defs/zone" } },
          "text_ownership_policy": {
            "type": "object",
            "required": ["editable_page_layer", "raster_visual_layer"],
            "properties": {
              "editable_page_layer": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "raster_visual_layer": { "type": "array", "items": { "type": "string", "minLength": 1 } }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "box": {
      "type": "object",
      "required": ["x", "y", "w", "h"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "w": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "h": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      }
    },
    "region": {
      "type": "object",
      "required": ["region_id", "role", "relative_box"],
      "properties": {
        "region_id": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "relative_box": { "$ref": "#/$defs/box" },
        "required_text_roles": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "zone": {
      "type": "object",
      "required": ["zone_id", "reason", "relative_box"],
      "properties": {
        "zone_id": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "relative_box": { "$ref": "#/$defs/box" }
      }
    }
  },
  "additionalProperties": true
}
