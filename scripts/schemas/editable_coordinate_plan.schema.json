{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PPT Skill Editable Coordinate Plan",
  "type": "object",
  "required": ["schema_version", "coordinate_mode", "basis", "slides"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "coordinate_mode": { "const": "approved_image_geometry" },
    "basis": {
      "type": "object",
      "properties": {
        "text_unit_split_plan": { "type": "string" },
        "font_calibration_profile": { "type": "string" },
        "native_style_probe_status": { "enum": ["draft", "passed", "needs_rework"] },
        "font_probe_status": { "enum": ["draft", "passed", "needs_rework"] }
      },
      "additionalProperties": true
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["slide_index", "source_image", "text_units"],
        "properties": {
          "slide_index": { "type": "integer" },
          "source_image": {
            "type": "object",
            "required": ["path", "width_px", "height_px", "sha256"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "width_px": { "type": "integer", "minimum": 1 },
              "height_px": { "type": "integer", "minimum": 1 },
              "sha256": { "type": "string", "pattern": "^sha256:" }
            }
          },
          "stage3_background_image": {
            "type": "object",
            "required": ["path", "width_px", "height_px", "sha256", "source_stage2_sha256"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "width_px": { "type": "integer", "minimum": 1 },
              "height_px": { "type": "integer", "minimum": 1 },
              "aspect_ratio": { "type": "string", "pattern": "^[0-9]+:[0-9]+$" },
              "sha256": { "type": "string", "pattern": "^sha256:" },
              "source_stage2_sha256": { "type": "string", "pattern": "^sha256:" }
            }
          },
          "coordinate_canvas": {
            "type": "object",
            "required": ["basis", "width_px", "height_px", "scale_x_from_stage2", "scale_y_from_stage2"],
            "properties": {
              "basis": { "const": "stage3_background_image" },
              "width_px": { "type": "integer", "minimum": 1 },
              "height_px": { "type": "integer", "minimum": 1 },
              "scale_x_from_stage2": { "type": "number" },
              "scale_y_from_stage2": { "type": "number" }
            }
          },
          "text_units": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/text_unit" } },
          "native_elements": { "type": "array", "items": { "$ref": "#/$defs/native_element" } }
        }
      }
    }
  },
  "$defs": {
    "relative_box": {
      "type": "object",
      "required": ["x", "y", "w", "h"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "w": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "h": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      }
    },
    "pixel_box": {
      "type": "object",
      "required": ["x", "y", "w", "h"],
      "properties": {
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 },
        "w": { "type": "integer", "minimum": 1 },
        "h": { "type": "integer", "minimum": 1 }
      }
    },
    "text_unit": {
      "type": "object",
      "required": ["text_unit_id", "ownership_id", "content_source", "text", "semantic_role", "geometry_source", "box_px", "relative_box", "font", "paragraph", "fit_policy"],
      "properties": {
        "text_unit_id": { "type": "string", "minLength": 1 },
        "ownership_id": { "type": "string", "minLength": 1 },
        "split_unit_id": { "type": "string", "minLength": 1 },
        "style_profile_id": { "type": "string", "minLength": 1 },
        "visual_group_id": { "type": "string", "minLength": 1 },
        "content_source": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "display_text": { "type": "string", "minLength": 1 },
        "wrap_policy": {
          "type": "object",
          "required": ["mode"],
          "properties": {
            "mode": { "enum": ["manual_line_break", "single_line", "preserve_existing"] },
            "line_count": { "type": "integer", "minimum": 1 },
            "preserve_manual_breaks": { "type": "boolean" }
          },
          "additionalProperties": true
        },
        "semantic_role": { "type": "string", "minLength": 1 },
        "geometry_source": { "type": "object" },
        "box_px": { "$ref": "#/$defs/pixel_box" },
        "relative_box": { "$ref": "#/$defs/relative_box" },
        "calculation": { "type": "object" },
        "font": { "type": "object" },
        "paragraph": { "type": "object" },
        "fit_policy": { "type": "object" }
      }
    },
    "native_element": {
      "type": "object",
      "required": ["element_id", "type", "box_px", "relative_box", "z_order"],
      "properties": {
        "element_id": { "type": "string", "minLength": 1 },
        "type": { "enum": ["rect", "round_rect", "ellipse", "line"] },
        "box_px": { "$ref": "#/$defs/pixel_box" },
        "relative_box": { "$ref": "#/$defs/relative_box" },
        "fill": { "type": "string", "pattern": "^#" },
        "stroke": { "type": "string", "pattern": "^#" },
        "z_order": { "enum": ["under_text", "over_text"] },
        "linked_text_unit_id": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
