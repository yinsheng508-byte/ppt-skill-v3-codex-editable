{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PPT Skill Text Ownership Map",
  "type": "object",
  "required": ["schema_version", "basis", "slides"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "basis": { "type": "object" },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["slide_index", "editable_page_layer", "raster_visual_layer", "unresolved_items"],
        "properties": {
          "slide_index": { "type": "integer" },
          "editable_page_layer": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/editable_item" } },
          "raster_visual_layer": { "type": "array", "items": { "$ref": "#/$defs/raster_item" } },
          "unresolved_items": { "type": "array", "maxItems": 0 }
        }
      }
    }
  },
  "$defs": {
    "editable_item": {
      "type": "object",
      "required": ["ownership_id", "text_source", "expected_text", "semantic_role", "remove_from_background", "restore_as_editable"],
      "properties": {
        "ownership_id": { "type": "string", "minLength": 1 },
        "text_source": { "type": "string", "minLength": 1 },
        "expected_text": { "type": "string", "minLength": 1 },
        "semantic_role": { "type": "string", "minLength": 1 },
        "split_unit_id": { "type": "string", "minLength": 1 },
        "style_role": { "type": "string", "minLength": 1 },
        "visual_group_id": { "type": "string", "minLength": 1 },
        "remove_from_background": { "type": "boolean" },
        "restore_as_editable": { "type": "boolean" }
      }
    },
    "raster_item": {
      "type": "object",
      "required": ["ownership_id", "description", "preserve_in_background"],
      "properties": {
        "ownership_id": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "expected_text": { "type": "string" },
        "semantic_role": { "type": "string" },
        "preserve_in_background": { "type": "boolean" }
      }
    }
  },
  "additionalProperties": true
}
