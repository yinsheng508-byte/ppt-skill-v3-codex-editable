{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PPT Skill Native Render Check",
  "type": "object",
  "required": ["schema_version", "overall_status", "contact_sheet", "checked_slides", "high_risk_slides", "findings"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "overall_status": { "enum": ["passed", "needs_rework"] },
    "contact_sheet": { "type": "string", "minLength": 1 },
    "checked_slides": { "type": "array", "minItems": 1, "items": { "type": "integer" } },
    "high_risk_slides": { "type": "array", "items": { "type": "integer" } },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["slide_index", "severity", "description", "resolved"],
        "properties": {
          "slide_index": { "type": "integer" },
          "severity": { "enum": ["info", "warning", "blocking"] },
          "description": { "type": "string", "minLength": 1 },
          "resolved": { "type": "boolean" }
        }
      }
    },
    "calibration_results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["probe_slide_index", "font_calibration_profile", "probe_compare", "review_status"],
        "properties": {
          "probe_slide_index": { "type": "integer" },
          "font_calibration_profile": { "type": "string", "minLength": 1 },
          "probe_compare": { "type": "string", "minLength": 1 },
          "review_status": { "enum": ["draft", "passed", "needs_rework"] },
          "notes": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
