{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PPT Skill v2 Stage1 Slide Plan",
  "type": "object",
  "required": ["schema_version", "slides"],
  "properties": {
    "schema_version": { "const": "2.0" },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["slide_index", "title", "purpose", "core_content", "visual_intent"],
        "properties": {
          "slide_index": { "type": "integer" },
          "title": { "type": "string" },
          "purpose": { "type": "string" },
          "core_content": { "type": "string" },
          "page_role": { "type": "string" },
          "source_basis": { "type": "array", "items": { "type": "object" } },
          "visual_intent": { "type": "string" }
        }
      }
    }
  },
  "additionalProperties": true
}
