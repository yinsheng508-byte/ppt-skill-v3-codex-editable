{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PPT Skill Text Unit Split Plan",
  "type": "object",
  "required": ["schema_version", "basis", "slides"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "basis": { "type": "object" },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["slide_index", "units"],
        "properties": {
          "slide_index": { "type": "integer" },
          "page_complexity": { "type": "string" },
          "units": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/split_unit" }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "$defs": {
    "split_unit": {
      "type": "object",
      "required": [
        "split_unit_id",
        "text",
        "content_source",
        "semantic_role",
        "style_role",
        "visual_group_id",
        "must_be_separate_shape",
        "restore_as_editable",
        "background_action"
      ],
      "properties": {
        "split_unit_id": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "content_source": { "type": "string", "minLength": 1 },
        "semantic_role": { "type": "string", "minLength": 1 },
        "style_role": { "type": "string", "minLength": 1 },
        "visual_group_id": { "type": "string", "minLength": 1 },
        "must_be_separate_shape": { "type": "boolean" },
        "restore_as_editable": { "type": "boolean" },
        "background_action": {
          "enum": ["remove_and_restore", "preserve_in_background"]
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
